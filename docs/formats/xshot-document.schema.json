{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cracvision/XcreenShot/docs/formats/xshot-document.schema.json",
  "title": "XcreenShot document (document.json inside a .xshot file), format 1.x",
  "description": "Positions and sizes are image pixels with the origin at the top-left corner of the canvas. Fields this schema does not list are allowed: newer minor versions add them and older apps keep them when saving (EDT-106).",
  "type": "object",
  "required": ["type", "canvas", "crop", "dpi", "objects"],
  "properties": {
    "type": { "type": "string", "enum": ["image", "guide"] },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "color": { "type": "string", "description": "#RRGGBB or #RRGGBBAA; absent means transparent" },
        "cornerRadius": { "type": "number", "minimum": 0 }
      }
    },
    "crop": {
      "$ref": "#/$defs/pixelRect",
      "description": "Where the canvas sits over base.png (the original pixels, never cropped), in base pixels"
    },
    "cropHistory": { "type": "array", "items": { "$ref": "#/$defs/pixelRect" } },
    "frame": {
      "$ref": "#/$defs/pixelRect",
      "description": "The crop the user chose, while the canvas is larger to fit objects that stick out of it (EDT-071); absent when the canvas is that crop. crop may then reach past base.png"
    },
    "outside": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids of objects a crop left outside the canvas; they do not make it grow"
    },
    "dpi": { "type": "number", "minimum": 1, "description": "Resolution written to exported files" },
    "objects": {
      "type": "array",
      "description": "Annotations, bottom first. Each has an id and a type; the properties depend on the type.",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/arrow" },
          { "$ref": "#/$defs/image" },
          { "$ref": "#/$defs/otherObject" }
        ]
      }
    },
    "flattened": {
      "type": "array",
      "description": "Objects merged into the image (EDT-091), oldest first. Drawn over base.png and under the objects; they can become objects again.",
      "items": {
        "type": "object",
        "required": ["id", "objects"],
        "properties": {
          "id": { "type": "string", "description": "f1, f2…" },
          "objects": {
            "type": "array",
            "description": "The objects as they were, in base pixels (not canvas pixels): a crop does not move them.",
            "items": { "oneOf": [{ "$ref": "#/$defs/arrow" }, { "$ref": "#/$defs/image" }, { "$ref": "#/$defs/otherObject" }] }
          },
          "permanent": {
            "type": "string",
            "description": "Why it cannot become objects again (blur, covered). Written files have none: such a layer is merged into base.png."
          }
        }
      }
    },
    "effects": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "pixelRect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "arrow": {
      "type": "object",
      "required": ["id", "type", "from", "to", "style"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["arrow"] },
        "locked": { "type": "boolean", "description": "Locked: the mouse cannot select or move it (EDT-085)" },
        "groups": { "type": "array", "items": { "type": "string" }, "description": "Groups it belongs to, outermost first (EDT-082)" },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "style": {
          "type": "object",
          "required": ["color", "width", "startCap", "endCap", "lineStyle", "opacity"],
          "properties": {
            "color": { "type": "string" },
            "width": { "type": "number", "minimum": 1, "maximum": 100 },
            "startCap": { "$ref": "#/$defs/cap" },
            "endCap": { "$ref": "#/$defs/cap" },
            "lineStyle": { "type": "string", "enum": ["solid", "dash", "dot", "dashDot"] },
            "opacity": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "description": "Floating image (EDT-078): a picture of the file's images/ folder drawn in rect, turned by rotation degrees around its center",
      "required": ["id", "type", "image", "rect", "rotation", "style"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image"] },
        "locked": { "type": "boolean", "description": "Locked: the mouse cannot select or move it (EDT-085)" },
        "groups": { "type": "array", "items": { "type": "string" }, "description": "Groups it belongs to, outermost first (EDT-082)" },
        "image": { "type": "string", "description": "File name inside images/" },
        "rect": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number", "minimum": 1 },
            "h": { "type": "number", "minimum": 1 }
          }
        },
        "rotation": { "type": "number" },
        "style": {
          "type": "object",
          "required": ["opacity"],
          "properties": { "opacity": { "type": "number", "minimum": 0, "maximum": 100 } }
        }
      }
    },
    "cap": {
      "type": "string",
      "enum": [
        "none",
        "filled",
        "open",
        "thin",
        "concave",
        "circle",
        "circleHollow",
        "square",
        "diamond",
        "bar"
      ]
    },
    "otherObject": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" }
      }
    }
  }
}
